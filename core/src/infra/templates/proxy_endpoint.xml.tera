<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description>{{ proxy_name | escape }}</Description>
  <PreFlow name="PreFlow">
    <Request>
{% for policy in pre_flow_request %}      <Step><Name>{{ policy }}</Name></Step>
{% endfor %}    </Request>
    <Response />
  </PreFlow>
{% for flow in conditional_flows %}  <Flows>
    <Flow name="{{ flow.name }}">
      <Description>{{ flow.condition | escape }}</Description>
      <Condition>{{ flow.condition | escape }}</Condition>
      <Request>
{% for policy in flow.request %}        <Step><Name>{{ policy }}</Name></Step>
{% endfor %}      </Request>
      <Response />
    </Flow>
  </Flows>
{% endfor %}  <PostFlow name="PostFlow">
    <Request />
    <Response />
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/{{ proxy_name | escape }}</BasePath>
    <Properties />
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
