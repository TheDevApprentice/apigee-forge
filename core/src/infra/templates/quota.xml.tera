<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Quota name="{{ policy.name | escape }}">
  <DisplayName>{{ policy.name | escape }}</DisplayName>
  <Allow count="{{ policy.allow }}"/>
  <Interval>{{ policy.interval }}</Interval>
  <TimeUnit>{{ policy.time_unit | escape }}</TimeUnit>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
</Quota>
