# Google OAuth Desktop application client ID (public configuration)
APIGEE_FORGE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required if Google returns invalid_request: client_secret is missing.
# Never commit the real value.
APIGEE_FORGE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional local keyring alias for this GUI profile.
# It is not the Google email and is not a secret.
APIGEE_FORGE_OAUTH_USERNAME=desktop
